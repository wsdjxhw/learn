# FastAPI 对外访问端口。
# 如果 8000 被占用，可以改成 9000，再重新 docker compose up。
APP_PORT=8000

# 应用标题会显示在 /docs 和 /health 里。
APP_TITLE=AI Chat UI Docker

# 默认占位 key 会让 provider.py 走 mock 模式。
# 要调用真实 DeepSeek，再改成真实 key；不要把真实 .env 提交到 Git。
DEEPSEEK_API_KEY=put-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-v4-flash

# PostgreSQL 容器配置。
# 当前 app 服务仍使用 SQLite，PostgreSQL 先作为部署模块里的数据库容器练习对象。
POSTGRES_DB=ai_learn
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
POSTGRES_PORT=5433
