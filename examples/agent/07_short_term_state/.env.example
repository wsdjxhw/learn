# mock 模式不需要真实 API Key，适合第一次学习和接口调试。
MODEL_MODE=mock

# 如果要调用 DeepSeek，把 MODEL_MODE 改成 deepseek，并填入真实 key。
# 本模块用 openai Python 包的兼容协议调用 DeepSeek。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 默认使用当前目录下的 SQLite 文件。
# Java 类比：这相当于本地开发环境的数据源配置。
DATABASE_URL=sqlite:///./agent_state.db
