# 默认 mock 模式，不需要任何真实模型 API Key。
MODEL_MODE=mock

# 如果要切换到 DeepSeek：
# 1. MODEL_MODE 改成 deepseek
# 2. 填写 DEEPSEEK_API_KEY
# 3. 本模块通过 openai Python 包的 OpenAI 兼容协议调用 DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 默认使用 SQLite，第一次启动会自动创建数据库文件。
DATABASE_URL=sqlite:///./agent_human_confirmation.db

# 教学用 API Key，不是真实密钥。
# 不传 X-API-Key 时，接口默认使用 learner-key，对应 viewer 角色。
LEARNER_API_KEY=learner-key
OPERATOR_API_KEY=operator-key
ADMIN_API_KEY=admin-key
