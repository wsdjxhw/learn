# mock 表示不调用真实模型，适合第一次学习和没有 key 的情况。
# deepseek 表示使用 openai Python 包，通过 OpenAI 兼容协议调用 DeepSeek。
MODEL_MODE=mock

# MODEL_MODE=deepseek 时才需要填写。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 默认使用当前目录下的 SQLite 文件。
DATABASE_URL=sqlite:///./agent_memory_governance.db
