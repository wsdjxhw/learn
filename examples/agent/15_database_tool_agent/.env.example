# ============================================================
# 数据库工具智能体 - 环境变量配置示例
# 使用方式：把本文件复制为 .env，然后按需修改
#   在 Windows 上：copy .env.example .env
#   （没有 API Key 也不用慌，MOCK_MODE=true 时完全不需要 key）
# ============================================================

# 数据库连接串
# 教学版默认用本地 SQLite 文件，方便零依赖启动。
# 真实项目会改成 PostgreSQL，例如：
#   postgresql+psycopg://user:password@localhost:5432/agent_db
DATABASE_URL=sqlite:///./agent_database.db

# mock 模式：true 时不调用任何外部模型，没有 API Key 也能跑通
# 想体验真实模型，改成 false 并填好下面的 DEEPSEEK_API_KEY
MOCK_MODE=true

# ---------- DeepSeek 配置（MOCK_MODE=false 时才需要）----------
# 本模块使用 openai Python 包，通过 OpenAI 兼容协议调用 DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 角色 API Key ----------
# 请求时通过请求头 X-API-Key 携带，映射到不同角色：
#   viewer（只读）：只能查询，不能写，不能审批
#   operator（操作员）：可以查询，写操作必须走人工确认，可以审批
#   admin（管理员）：权限等同 operator，本模块为安全演示统一保留确认环节
VIEWER_API_KEY=sk-viewer-0000000001
OPERATOR_API_KEY=sk-operator-0000000001
ADMIN_API_KEY=sk-admin-0000000001

# Agent 循环最大步数，防止模型无限调用工具
MAX_AGENT_STEPS=3
