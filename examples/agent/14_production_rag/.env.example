# ============================================================
# 14 生产级 RAG 工程 - 环境配置
# 复制本文件为 .env 后按需修改。不复制也能跑（默认值兜底）。
# ============================================================

# 默认 mock 模式，不需要任何真实模型 API Key。
# mock 模式下：文件解析、检索、rerank、Agent 决策都在本地完成。
MODEL_MODE=mock

# 如果要切换到 DeepSeek：
# 1. MODEL_MODE 改成 deepseek
# 2. 填写 DEEPSEEK_API_KEY
# 3. 本模块通过 openai Python 包的 OpenAI 兼容协议调用 DeepSeek
# 4. 真实模式下 Agent 会自己决定是否检索、检索词是什么、如何组织带 sources 的回答
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 默认使用 SQLite，第一次启动会自动创建数据库文件。
# 本模块的 documents / chunks / search_logs 表都存这一个文件里。
DATABASE_URL=sqlite:///./agent_production_rag.db

# 教学用 API Key，不是真实密钥。
# 每个 key 对应一个“用户身份”，用于演示文档级权限隔离：
#   learner-key   -> alice（viewer，只能看 public 和属于自己的文档）
#   operator-key  -> bob（operator，同样受文档权限约束）
#   admin-key     -> admin（admin，能看和删所有文档）
# 不传 X-API-Key 时，接口默认使用 learner-key。
LEARNER_API_KEY=learner-key
OPERATOR_API_KEY=operator-key
ADMIN_API_KEY=admin-key
